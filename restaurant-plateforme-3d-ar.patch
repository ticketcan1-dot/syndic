+const SOURCE_LABEL = { scan: 'Scan 3D importé', ai: 'Reconstruction depuis vos photos', plate: 'Aperçu généré depuis la photo' };
+
+const box = { padding: '1.5rem', background: '#f5f3ff', borderRadius: 'var(--radius-lg)', marginBottom: '2rem' };
+const btn = (bg = 'white') => ({ display: 'flex', alignItems: 'center', gap: '0.5rem', padding: '0.7rem 1rem', borderRadius: '0.8rem', border: '1px solid #ddd', background: bg, fontWeight: 700, fontSize: '0.85rem', cursor: 'pointer' });
+
+/**
+ * 3D section of the dish form. `model3d` is part of the form data; actions that need the
+ * server (AI reconstruction, rescale) are only available once the dish has been saved (`dishId`).
+ */
+export default function Model3DPanel({ dishId, model3d = {}, photo, onChange, aiEnabled }) {
+    const [studio, setStudio] = useState(false);
+    const [busy, setBusy] = useState('');
+    const [progress, setProgress] = useState(null);
+    const pollRef = useRef(null);
+    const m = { status: 'none', captureImages: [], realDiameterCm: 26, ...model3d };
+
+    const set = (patch) => onChange({ ...m, ...patch });
+
+    // Poll the AI reconstruction while it runs
+    useEffect(() => {
+        if (m.status !== 'processing' || !dishId) return;
+        const tick = async () => {
+            try {
+                const res = await fetch(`/api/dishes/${dishId}/model3d`);
+                const json = await res.json();
+                if (json.success) onChange({ ...m, ...json.data });
+            } catch { /* retry on next tick */ }
+        };
+        pollRef.current = setInterval(tick, 5000);
+        return () => clearInterval(pollRef.current);
+        // eslint-disable-next-line react-hooks/exhaustive-deps
+    }, [m.status, dishId]);
+
+    const importScan = async (e) => {
+        const file = e.target.files?.[0];
+        if (!file) return;
+        const ext = file.name.toLowerCase().split('.').pop();
+        if (!['glb', 'usdz'].includes(ext)) return alert('Formats acceptés : .glb (Android/Web) et .usdz (iPhone).');
+        setBusy('upload');
+        setProgress(0);
+        try {
+            const url = await uploadFile(file, { onProgress: setProgress });
+            if (ext === 'glb') set({ glb: url, source: 'scan', status: 'ready', error: null });
+            else set({ usdz: url });
+        } catch (err) {
+            alert("Erreur d'import : " + err.message);
+        } finally {
+            setBusy('');
+            setProgress(null);
+            e.target.value = '';
+        }
+    };
+
+    const generatePreview = async () => {
+        if (!photo) return alert("Ajoutez d'abord la photo principale du plat.");
+        setBusy('plate');
+        try {
+            const { generatePlateGlb } = await import('@/lib/plate-generator');
+            const blob = await generatePlateGlb(photo, { diameterCm: m.realDiameterCm || 26 });
+            const url = await uploadFile(blob, { filename: 'apercu-3d.glb' });
+            set({ glb: url, usdz: null, source: 'plate', status: 'ready', error: null });
+        } catch (err) {
+            alert("Impossible de générer l'aperçu : " + err.message);
+        } finally {
+            setBusy('');
+        }
+    };
+
+    const reconstruct = async () => {
+        if (!dishId) return alert('Enregistrez le plat une première fois, puis lancez la reconstruction.');
+        setBusy('ai');
+        try {
+            // make sure the captured photos are saved on the dish first
+            await fetch(`/api/dishes/${dishId}`, {
+                method: 'PATCH', headers: { 'Content-Type': 'application/json' },
+                body: JSON.stringify({ model3d: { captureImages: m.captureImages, realDiameterCm: m.realDiameterCm } }),
+            });
+            const res = await fetch(`/api/dishes/${dishId}/model3d`, { method: 'POST' });
+            const json = await res.json();
+            if (!json.success) throw new Error(json.error);
+            onChange({ ...m, ...json.data });
+        } catch (err) {
+            alert(err.message);
+        } finally {
+            setBusy('');
+        }
+    };
+
+    const changeDiameter = async (cm) => {
+        set({ realDiameterCm: cm });
+        if (dishId && m.status === 'ready' && m.source !== 'scan') {
+            const res = await fetch(`/api/dishes/${dishId}/model3d`, {
+                method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ realDiameterCm: cm }),
+            });
+            const json = await res.json();
+            if (json.success) onChange({ ...m, ...json.data });
+        }
+    };
+
+    const remove = () => {
+        if (!confirm('Retirer le modèle 3D de ce plat ?')) return;
+        set({ glb: null, usdz: null, source: null, status: 'none', error: null });
+    };
+
+    return (
+        <div style={box}>
+            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: '1rem', marginBottom: '1rem', flexWrap: 'wrap' }}>
+                <h3 style={{ fontSize: '1rem', fontWeight: 700, display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
+                    <Box size={18} /> Plat en 3D & réalité augmentée
+                </h3>
+                {m.status === 'ready' && <span style={{ fontSize: '0.75rem', fontWeight: 800, background: '#dcfce7', color: '#166534', padding: '0.25rem 0.6rem', borderRadius: '1rem' }}>{SOURCE_LABEL[m.source] || 'Modèle prêt'}</span>}
+            </div>
+
+            {m.status === 'ready' && m.glb && (
+                <div style={{ marginBottom: '1rem' }}>
+                    <DishViewer3D model3d={m} name="Aperçu" poster={photo} height={260} compact />
+                </div>
+            )}
+
+            {m.status === 'processing' && (
+                <div style={{ display: 'flex', alignItems: 'center', gap: '0.8rem', padding: '1rem', background: 'white', borderRadius: '0.8rem', marginBottom: '1rem' }}>
+                    <Loader2 size={20} className="spin-slow" />
+                    <div style={{ flex: 1 }}>
+                        <div style={{ fontWeight: 700, fontSize: '0.9rem' }}>Reconstruction 3D en cours… {m.progress ? `${m.progress}%` : ''}</div>
+                        <div style={{ height: 6, background: '#eee', borderRadius: 3, marginTop: 6 }}>
+                            <div style={{ height: '100%', width: `${m.progress || 3}%`, background: '#8b5cf6', borderRadius: 3, transition: 'width 0.5s' }} />
+                        </div>
+                        <div style={{ fontSize: '0.75rem', color: 'var(--glovo-gray)', marginTop: 4 }}>Comptez 2 à 5 minutes. Vous pouvez fermer cette fenêtre.</div>
+                    </div>
+                </div>
+            )}
+
+            {m.status === 'failed' && m.error && (
+                <div style={{ padding: '0.8rem', background: '#fee2e2', color: '#991b1b', borderRadius: '0.8rem', fontSize: '0.85rem', marginBottom: '1rem' }}>{m.error}</div>
+            )}
+
+            {/* 1. Scan */}
+            <div style={{ display: 'grid', gap: '0.8rem' }}>
+                <div style={{ background: 'white', borderRadius: '0.8rem', padding: '1rem' }}>
+                    <div style={{ fontWeight: 800, fontSize: '0.9rem', marginBottom: 4 }}>① Scanner le plat avec la caméra</div>
+                    <p style={{ fontSize: '0.8rem', color: 'var(--glovo-gray)', marginBottom: '0.7rem' }}>
+                        Posez le plat sur une table bien éclairée, puis faites le tour en 3 hauteurs (24 à 40 photos).
+                    </p>
+                    <div style={{ display: 'flex', gap: '0.6rem', flexWrap: 'wrap', alignItems: 'center' }}>
+                        <button type="button" onClick={() => setStudio(true)} style={btn('var(--glovo-yellow)')}><ScanLine size={18} /> Lancer le scan</button>
+                        {m.captureImages?.length > 0 && (
+                            <>
+                                <span style={{ fontSize: '0.8rem', fontWeight: 700 }}>{m.captureImages.length} photos</span>
+                                <button type="button" onClick={() => set({ captureImages: [] })} style={{ ...btn(), padding: '0.4rem 0.6rem' }}><Trash2 size={14} /></button>
+                            </>
+                        )}
+                    </div>
+                    {m.captureImages?.length > 0 && (
+                        <div style={{ display: 'flex', gap: 4, overflowX: 'auto', marginTop: '0.7rem' }}>
+                            {m.captureImages.slice(0, 20).map((u) => <img key={u} src={u} alt="" style={{ width: 44, height: 44, objectFit: 'cover', borderRadius: 6, flexShrink: 0 }} />)}
+                        </div>
+                    )}
+                    {m.captureImages?.length > 0 && (
+                        <div style={{ marginTop: '0.8rem' }}>
+                            {aiEnabled ? (
+                                <button type="button" onClick={reconstruct} disabled={busy === 'ai' || m.status === 'processing'} style={btn('#ede9fe')}>
+                                    <Sparkles size={18} /> {busy === 'ai' ? 'Envoi…' : 'Créer le modèle 3D à partir des photos'}
+                                </button>
+                            ) : (
+                                <p style={{ fontSize: '0.78rem', color: 'var(--glovo-gray)', display: 'flex', gap: 6 }}>
+                                    <Info size={14} style={{ flexShrink: 0, marginTop: 2 }} />
+                                    La reconstruction automatique n’est pas activée sur la plateforme. Vos photos sont conservées ; utilisez ② ou ③ en attendant.
+                                </p>
+                            )}
+                        </div>
+                    )}
+                </div>
+
+                {/* 2. Import from a scanning app */}
+                <div style={{ background: 'white', borderRadius: '0.8rem', padding: '1rem' }}>
+                    <div style={{ fontWeight: 800, fontSize: '0.9rem', marginBottom: 4 }}>② Importer un scan 3D (.glb / .usdz)</div>
+                    <p style={{ fontSize: '0.8rem', color: 'var(--glovo-gray)', marginBottom: '0.7rem' }}>
+                        Meilleure qualité : scannez le plat avec une application de photogrammétrie (Polycam, KIRI Engine, Scaniverse, Reality Composer sur iPhone…) et exportez en GLB.
+                    </p>
+                    <label style={{ ...btn(), display: 'inline-flex' }}>
+                        <Upload size={18} /> {busy === 'upload' ? `Import… ${Math.round((progress || 0) * 100)}%` : 'Choisir un fichier'}
+                        <input type="file" hidden accept=".glb,.usdz,model/gltf-binary,model/vnd.usdz+zip" onChange={importScan} disabled={!!busy} />
+                    </label>
+                    {m.usdz && <span style={{ marginLeft: 8, fontSize: '0.75rem', color: '#166534', fontWeight: 700 }}>USDZ iPhone ✓</span>}
+                </div>
+
+                {/* 3. Instant preview */}
+                <div style={{ background: 'white', borderRadius: '0.8rem', padding: '1rem' }}>
+                    <div style={{ fontWeight: 800, fontSize: '0.9rem', marginBottom: 4 }}>③ Aperçu 3D instantané depuis la photo</div>
+                    <p style={{ fontSize: '0.8rem', color: 'var(--glovo-gray)', marginBottom: '0.7rem' }}>
+                        Crée une assiette en 3D à taille réelle avec la photo du plat : idéal pour commencer tout de suite.
+                    </p>
+                    <button type="button" onClick={generatePreview} disabled={!!busy || !photo} style={btn()}>
+                        <Wand2 size={18} /> {busy === 'plate' ? 'Génération…' : 'Générer l’aperçu'}
+                    </button>
+                </div>
+            </div>
+
+            <div style={{ display: 'flex', alignItems: 'center', gap: '1rem', marginTop: '1rem', flexWrap: 'wrap' }}>
+                <label style={{ fontSize: '0.85rem', fontWeight: 700 }}>
+                    Diamètre réel de l’assiette (cm)&nbsp;
+                    <input type="number" min={5} max={120} value={m.realDiameterCm || 26}
+                        onChange={(e) => set({ realDiameterCm: Number(e.target.value) })}
+                        onBlur={(e) => changeDiameter(Number(e.target.value))}
+                        style={{ width: 70, padding: '0.4rem', borderRadius: '0.4rem', border: '1px solid #ddd' }} />
+                </label>
+                {m.status === 'ready' && (
+                    <button type="button" onClick={remove} style={{ ...btn(), color: '#b91c1c' }}><Trash2 size={16} /> Retirer le modèle</button>
+                )}
+            </div>
+
+            {studio && (
+                <DishScanStudio
+                    initialPhotos={m.captureImages || []}
+                    onClose={() => setStudio(false)}
+                    onDone={(urls) => { set({ captureImages: urls }); setStudio(false); }}
+                />
+            )}
+        </div>
+    );
+}
diff --git a/src/components/admin/RestaurantSettings.js b/src/components/admin/RestaurantSettings.js
new file mode 100644
index 0000000..dc0d94f
--- /dev/null
+++ b/src/components/admin/RestaurantSettings.js
@@ -0,0 +1,112 @@
+"use client";
+import React, { useState } from 'react';
+import QRCode from 'react-qr-code';
+import { Save, ExternalLink, Upload, Copy, Box } from 'lucide-react';
+import { uploadFile, compressImage } from '@/lib/upload-client';
+
+const input = { width: '100%', padding: '0.8rem', borderRadius: '0.5rem', border: '1px solid #ddd' };
+const label = { display: 'block', marginBottom: '0.4rem', fontWeight: 600, fontSize: '0.9rem' };
+
+export default function RestaurantSettings({ restaurant, dishes = [], onSaved }) {
+    const [form, setForm] = useState(restaurant);
+    const [saving, setSaving] = useState(false);
+    const [uploading, setUploading] = useState('');
+    const origin = typeof window !== 'undefined' ? window.location.origin : '';
+    const menuUrl = `${origin}/r/${restaurant.slug}`;
+    const with3d = dishes.filter(d => d.model3d?.status === 'ready').length;
+
+    const upload = async (e, key) => {
+        const file = e.target.files?.[0];
+        if (!file) return;
+        setUploading(key);
+        try {
+            const url = await uploadFile(await compressImage(file, { maxSize: key === 'logo' ? 600 : 2000 }), { filename: `${key}.jpg` });
+            setForm(f => ({ ...f, [key]: url }));
+        } catch (err) {
+            alert(err.message);
+        } finally {
+            setUploading('');
+        }
+    };
+
+    const save = async (e) => {
+        e.preventDefault();
+        setSaving(true);
+        try {
+            const res = await fetch('/api/restaurant', {
+                method: 'PATCH', headers: { 'Content-Type': 'application/json' },
+                body: JSON.stringify(form),
+            });
+            const json = await res.json();
+            if (!json.success) throw new Error(json.error);
+            onSaved(json.data);
+            alert('Restaurant mis à jour !');
+        } catch (err) {
+            alert(err.message);
+        } finally {
+            setSaving(false);
+        }
+    };
+
+    return (
+        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(300px, 1fr))', gap: '1.5rem', alignItems: 'start' }}>
+            <form onSubmit={save} className="card" style={{ padding: '1.5rem', display: 'grid', gap: '1rem' }}>
+                <div style={{ position: 'relative', height: 140, borderRadius: '1rem', overflow: 'hidden', background: form.coverImage ? `center/cover url("${form.coverImage}")` : 'linear-gradient(135deg,#1a1a1a,#444)' }}>
+                    <label style={{ position: 'absolute', right: 10, bottom: 10, background: 'white', borderRadius: '1rem', padding: '0.3rem 0.7rem', fontSize: '0.8rem', fontWeight: 700, cursor: 'pointer', display: 'flex', gap: 4, alignItems: 'center' }}>
+                        <Upload size={14} /> {uploading === 'coverImage' ? '...' : 'Couverture'}
+                        <input type="file" hidden accept="image/*" onChange={(e) => upload(e, 'coverImage')} />
+                    </label>
+                    <label style={{ position: 'absolute', left: 14, bottom: 10, width: 64, height: 64, borderRadius: '50%', background: form.logo ? `center/cover url("${form.logo}")` : 'var(--glovo-yellow)', border: '3px solid white', cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: '0.65rem', fontWeight: 800 }}>
+                        {!form.logo && (uploading === 'logo' ? '...' : 'LOGO')}
+                        <input type="file" hidden accept="image/*" onChange={(e) => upload(e, 'logo')} />
+                    </label>
+                </div>
+                <div><label style={label}>Nom du restaurant</label><input style={input} required value={form.name || ''} onChange={(e) => setForm({ ...form, name: e.target.value })} /></div>
+                <div><label style={label}>Description</label><textarea style={{ ...input, height: 80 }} value={form.description || ''} onChange={(e) => setForm({ ...form, description: e.target.value })} /></div>
+                <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '0.8rem' }}>
+                    <div><label style={label}>Cuisine</label><input style={input} placeholder="Marocaine, burgers…" value={form.cuisine || ''} onChange={(e) => setForm({ ...form, cuisine: e.target.value })} /></div>
+                    <div><label style={label}>Devise</label><input style={input} value={form.currency || 'DH'} maxLength={5} onChange={(e) => setForm({ ...form, currency: e.target.value })} /></div>
+                    <div><label style={label}>Ville</label><input style={input} value={form.city || ''} onChange={(e) => setForm({ ...form, city: e.target.value })} /></div>
+                    <div><label style={label}>Téléphone</label><input style={input} value={form.phone || ''} onChange={(e) => setForm({ ...form, phone: e.target.value })} /></div>
+                </div>
+                <div><label style={label}>Adresse</label><input style={input} value={form.address || ''} onChange={(e) => setForm({ ...form, address: e.target.value })} /></div>
+                <div>
+                    <label style={label}>Adresse du menu</label>
+                    <div style={{ display: 'flex', alignItems: 'center', gap: 4, fontSize: '0.9rem' }}>
+                        <span style={{ color: 'var(--glovo-gray)', whiteSpace: 'nowrap' }}>/r/</span>
+                        <input style={input} value={form.slug || ''} onChange={(e) => setForm({ ...form, slug: e.target.value })} />
+                    </div>
+                </div>
+                <label style={{ display: 'flex', gap: 8, alignItems: 'center', fontWeight: 600 }}>
+                    <input type="checkbox" checked={form.acceptsOrders !== false} onChange={(e) => setForm({ ...form, acceptsOrders: e.target.checked })} />
+                    Accepter les commandes depuis le menu
+                </label>
+                <button type="submit" className="btn-primary" disabled={saving} style={{ justifyContent: 'center' }}>
+                    <Save size={18} /> {saving ? 'Enregistrement…' : 'Enregistrer'}
+                </button>
+            </form>
+
+            <div style={{ display: 'grid', gap: '1.5rem' }}>
+                <div className="card" style={{ padding: '1.5rem', textAlign: 'center' }}>
+                    <h3 style={{ marginBottom: '0.5rem' }}>Votre menu public</h3>
+                    <p style={{ color: 'var(--glovo-gray)', fontSize: '0.85rem', marginBottom: '1rem' }}>QR général (vitrine, flyers, réseaux). Les QR par table sont dans l’onglet Tables.</p>
+                    <div style={{ background: 'white', padding: '1rem', display: 'inline-block', borderRadius: '1rem', boxShadow: '0 4px 12px rgba(0,0,0,0.1)' }}>
+                        <QRCode value={menuUrl} size={160} />
+                    </div>
+                    <div style={{ display: 'flex', gap: '0.5rem', justifyContent: 'center', marginTop: '1rem', flexWrap: 'wrap' }}>
+                        <a href={`/r/${restaurant.slug}`} target="_blank" rel="noreferrer" className="btn-primary" style={{ padding: '0.6rem 1rem' }}><ExternalLink size={16} /> Ouvrir</a>
+                        <button onClick={() => navigator.clipboard?.writeText(menuUrl)} style={{ padding: '0.6rem 1rem', border: '1px solid #ddd', borderRadius: 'var(--radius-xl)', display: 'flex', gap: 6, alignItems: 'center' }}><Copy size={16} /> Copier le lien</button>
+                    </div>
+                </div>
+                <div className="card" style={{ padding: '1.5rem' }}>
+                    <h3 style={{ marginBottom: '0.8rem', display: 'flex', gap: 8, alignItems: 'center' }}><Box size={20} /> Menu en 3D</h3>
+                    <div style={{ fontSize: '2rem', fontWeight: 900 }}>{with3d}<span style={{ fontSize: '1rem', color: 'var(--glovo-gray)' }}> / {dishes.length} plats</span></div>
+                    <div style={{ height: 8, background: '#eee', borderRadius: 4, margin: '0.6rem 0' }}>
+                        <div style={{ height: '100%', width: `${dishes.length ? (with3d / dishes.length) * 100 : 0}%`, background: '#8b5cf6', borderRadius: 4 }} />
+                    </div>
+                    <p style={{ fontSize: '0.85rem', color: 'var(--glovo-gray)' }}>Les clients peuvent poser ces plats sur leur table avec la caméra de leur téléphone. Ouvrez un plat dans l’onglet Plats pour le scanner.</p>
+                </div>
+            </div>
+        </div>
+    );
+}
diff --git a/src/components/ar/DishViewer3D.js b/src/components/ar/DishViewer3D.js
new file mode 100644
index 0000000..52ba2f6
--- /dev/null
+++ b/src/components/ar/DishViewer3D.js
@@ -0,0 +1,116 @@
+"use client";
+import React, { useEffect, useRef, useState } from 'react';
+import { Box, Smartphone, RotateCcw } from 'lucide-react';
+
+let loader;
+const loadModelViewer = () => (loader ||= import('@google/model-viewer'));
+
+/**
+ * 3D viewer + "Voir sur ma table" (augmented reality).
+ * - Android: Scene Viewer / WebXR, iPhone: Quick Look (USDZ generated on the fly when none is provided).
+ */
+export default function DishViewer3D({ model3d, name, poster, height = 340, compact = false, autoRotate = true }) {
+    const ref = useRef(null);
+    const [ready, setReady] = useState(false);
+    const [loaded, setLoaded] = useState(false);
+    const [arSupported, setArSupported] = useState(null);
+    const [arStatus, setArStatus] = useState('');
+
+    useEffect(() => {
+        let alive = true;
+        loadModelViewer().then(() => alive && setReady(true));
+        return () => { alive = false; };
+    }, []);
+
+    useEffect(() => {
+        const el = ref.current;
+        if (!ready || !el) return;
+
+        const onLoad = () => {
+            setLoaded(true);
+            setArSupported(Boolean(el.canActivateAR));
+            // Real-world size is baked into the GLB on the server (see lib/glb.js), so the
+            // model has the same size in the page, in Scene Viewer (Android) and in Quick Look (iPhone).
+        };
+        const onAr = (e) => {
+            const s = e.detail?.status;
+            setArStatus(s === 'failed' ? "La réalité augmentée n'a pas pu démarrer sur cet appareil." : '');
+        };
+        el.addEventListener('load', onLoad);
+        el.addEventListener('ar-status', onAr);
+        return () => {
+            el.removeEventListener('load', onLoad);
+            el.removeEventListener('ar-status', onAr);
+        };
+    }, [ready, model3d.glb]);
+
+    if (!model3d?.glb) return null;
+
+    return (
+        <div style={{ position: 'relative', width: '100%', height, borderRadius: compact ? '1rem' : '1.5rem', overflow: 'hidden', background: 'radial-gradient(circle at 50% 35%, #fff 0%, #f1ece4 70%)' }}>
+            {ready && (
+                <model-viewer
+                    ref={ref}
+                    src={model3d.glb}
+                    ios-src={model3d.usdz || undefined}
+                    poster={model3d.poster || poster || undefined}
+                    alt={`Modèle 3D : ${name}`}
+                    camera-controls=""
+                    touch-action="pan-y"
+                    auto-rotate={autoRotate ? '' : undefined}
+                    auto-rotate-delay="1500"
+                    rotation-per-second="18deg"
+                    camera-orbit="0deg 60deg auto"
+                    shadow-intensity="1.2"
+                    shadow-softness="0.8"
+                    exposure="1.05"
+                    environment-image="neutral"
+                    interaction-prompt="auto"
+                    ar=""
+                    ar-modes="webxr scene-viewer quick-look"
+                    ar-placement="floor"
+                    ar-scale="fixed"
+                    xr-environment=""
+                    style={{ width: '100%', height: '100%', '--poster-color': 'transparent' }}
+                >
+                    {/* Default AR button is replaced by ours */}
+                    <button
+                        slot="ar-button"
+                        style={{
